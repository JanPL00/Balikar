FROM alpine:latest

# Install build dependencies
RUN apk add --no-cache \
    build-base \
    cmake \
    git \
    curl-dev \
    curl-static \
    jansson-dev \
    jansson-static \
    libarchive-dev \
    libarchive-static \
    openssl-libs-static \
    zlib-static \
    xz-dev \
    bzip2-dev \
    zstd-dev \
    zstd-static

WORKDIR /tmp

# Build libsolv statically with conda support
RUN git clone https://github.com/openSUSE/libsolv.git && \
    cd libsolv && \
    mkdir build && cd build && \
    cmake .. \
        -DBUILD_SHARED_LIBS=OFF \
        -DENABLE_CONDA=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install && \
    cd /tmp && rm -rf libsolv

# Copy project source
COPY . /build
WORKDIR /build

# Build balikar statically
# Alpine's musl automatically prefers static linking when .a files are available
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_STATIC=ON \
    -DCONDA_PREFIX=/usr && \
    cmake --build build -j$(nproc)

# Verify static build
RUN file build/balikar && \
    ldd build/balikar 2>&1 || true && \
    ls -lh build/balikar

CMD ["/build/balikar", "--help"]
