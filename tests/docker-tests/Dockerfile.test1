# Balikar Package Manager - Test 1: Basic Workflow
#
# Testuje zakladni prikazy: --help, repos, repo-update, resolve,
# --dry-run, download, build, install (jednoduche balicky bez zavislosti),
# clean-cache a volbu -d (debug).
#
# Doporuceny limit RAM: 128 MB
#   docker run --memory=128m --memory-swap=128m ...
#
# Simuluje: minimalni Debian 12 zarizeni s nainstalovanymi pouze
# knihovnami nutnymi pro beh systemu + build tools, ktere nejsou
# dostupne v balikar-repository.

FROM debian:12-slim

LABEL description="Balikar Package Manager - Test 1: Basic Workflow"
LABEL version="1.0"
LABEL ram_limit="128m"
LABEL tests="help, repos, repo-update, resolve, dry-run, download, build, install, clean-cache"

ENV DEBIAN_FRONTEND=noninteractive

# Minimalni SW predinstalovaný v kontejneru:
#
# Balikar runtime (nejsou v balikar-repository):
#   libcurl4, libjansson4, libarchive13 - dynamicke zavislosti balikar binary
#   ca-certificates                     - overeni HTTPS certifikatu pri stazeni
#
# Nastroje pro extrakci archivu (nejsou v balikar-repository):
#   xz-utils  - extrakce .tar.xz archivu
#   bzip2     - extrakce .tar.bz2 archivu
#
# Build nastroje (v balikar-repository figuruji jako no_package=true,
# tj. balikar je povazuje za "uz nainstalovane" - musi byt predinstaleny):
#   gcc, g++  - kompilatoru C/C++
#   make      - spoustec Makefile
#
# Dalsi build nastroje chybejici v balikar-repository:
#   autoconf, automake - generovani configure skriptu (napr. gzip)
# POZNAMKA: bison, gettext jsou v balikar-repository (no_package=False)
#   -> balikar je nainstaluje sam jako zavislosti, pokud je balicek potrebuje
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4 \
    libjansson4 \
    libarchive13 \
    ca-certificates \
    xz-utils \
    bzip2 \
    gcc \
    g++ \
    make \
    autoconf \
    automake \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Adresarova struktura pro balikar
RUN mkdir -p /var/cache/balikar/downloads \
    && mkdir -p /var/lib/balikar \
    && mkdir -p /etc/balikar \
    && mkdir -p /usr/local/bin \
    && mkdir -p /test

# Konfigurace repozitare - GitHub jako zdroj balicku
RUN printf '[balikar-official]\n' > /etc/balikar/repos.conf && \
    printf 'url = https://raw.githubusercontent.com/JanPL00/balikar-repository/main\n' >> /etc/balikar/repos.conf && \
    printf 'priority = 100\n' >> /etc/balikar/repos.conf && \
    printf 'enabled = true\n' >> /etc/balikar/repos.conf

ENV PATH=/usr/local/bin:$PATH

# Test skript - pokryva prikazy z manual.txt
COPY test1.sh /test/run_tests.sh
RUN chmod +x /test/run_tests.sh

WORKDIR /test

CMD ["/test/run_tests.sh"]
