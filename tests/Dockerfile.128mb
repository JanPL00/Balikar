# Docker image pro testování Balikar s 128 MB RAM limitem
# Test: Instalace nmap a závislostí v omezené paměti

FROM debian:12-slim

# Metadata
LABEL description="Balikar Package Manager - 128 MB RAM Test Environment"
LABEL version="1.0"
LABEL memory_limit="128m"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Instalace MINIMÁLNÍCH závislostí pro balikar runtime
# POUZE co je nezbytné pro běh balikar binary + build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4 \
    libjansson4 \
    libarchive13 \
    ca-certificates \
    xz-utils \
    bzip2 \
    gzip \
    tar \
    patch \
    gcc \
    g++ \
    make \
    python3 \
    perl \
    linux-libc-dev \
    bison \
    gawk \
    autoconf \
    automake \
    libtool \
    gettext \
    flex \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Vytvoření adresářové struktury pro balikar
RUN mkdir -p /var/cache/balikar/downloads \
    && mkdir -p /var/lib/balikar \
    && mkdir -p /etc/balikar \
    && mkdir -p /usr/local/bin \
    && mkdir -p /test_root

# Konfigurační soubor pro balikar (GitHub repository)
RUN echo "[default]" > /etc/balikar/repos.conf && \
    echo "name = Balikar Repository" >> /etc/balikar/repos.conf && \
    echo "url = https://raw.githubusercontent.com/JanPL00/balikar-repository/main" >> /etc/balikar/repos.conf

# Environment pro testování
ENV PATH=/usr/local/bin:/balikar:$PATH

# Nastavení pracovního adresáře
WORKDIR /test

# Výchozí příkaz
CMD ["/bin/bash"]
