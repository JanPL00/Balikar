@startuml Balikar Core Components

title Balikar Core Modules – Interfaces Overview

left to right direction
skinparam componentStyle rectangle
skinparam interfaceBackgroundColor LightCyan
skinparam interfaceBorderColor DarkBlue
skinparam nodesep 90
skinparam ranksep 120
skinparam linetype ortho

rectangle "Command Entry" {
	component [Main CLI\n(main.c)] as main <<executable>>
}

' Core components (ordered by workflow)
rectangle "Core Workflow" {
	component [Config\n(config.c)] as config
	component [Parser\n(parser.c)] as parser
	component [Solver\n(solver.c)] as solver
	component [Downloader\n(downloader.c)] as downloader
	component [Builder\n(builder.c)] as builder
	component [Installer\n(installer.c)] as installer
}

rectangle "Shared Services" {
	component [Common\n(common.c)] as common
}

' Provided interfaces (lollipop)
interface "IRepositoryLoader" as IRepoLoader
interface "IDependencyResolver" as IDepResolver
interface "IPackageDownloader" as IPkgDownloader
interface "IPackageBuilder" as IPkgBuilder
interface "IPackageInstaller" as IPkgInstaller
interface "IConfigManager" as IConfigMgr
interface "ILogger" as ILogger

config -up- IConfigMgr
parser -up- IRepoLoader
solver -up- IDepResolver
downloader -up- IPkgDownloader
builder -up- IPkgBuilder
installer -up- IPkgInstaller
common -up- ILogger

' Interface method descriptions
note right of IConfigMgr
  **IConfigManager API:**
  • init_repo_config()
  • get_primary_repo_url()
  • get_enabled_repos()
  • add_repository()
  • remove_repository()
  • enable_repository()
  • save_repo_config()
  • list_repositories()
  • free_repo_config()
end note

