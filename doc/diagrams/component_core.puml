note right of IPkgInstaller
  **IPackageInstaller API:**
  • install_package()
  • is_package_installed()
  • get_installed_packages()
  • erase_package()
  • validate_chroot()
end note

note left of ILogger
  **ILogger API:**
  • log_error()
  • log_warn()
  • log_info()
  • log_debug()
end note

' Required interfaces (socket) – assembly connectors
main --( IRepoLoader
main --( IDepResolver
main --( IPkgDownloader
main --( IPkgBuilder
main --( IPkgInstaller
main --( IConfigMgr

builder --( IRepoLoader
builder --( IPkgDownloader
solver --( IRepoLoader
downloader --( IRepoLoader

' Logging dependency via ILogger interface
parser --( ILogger
solver --( ILogger
downloader --( ILogger
builder --( ILogger
installer --( ILogger
config --( ILogger

@enduml
