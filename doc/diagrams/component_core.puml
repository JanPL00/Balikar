@startuml Balikar Core Components

title Balikar Core Modules – Interfaces Overview

left to right direction
skinparam componentStyle rectangle
skinparam interfaceBackgroundColor LightCyan
skinparam interfaceBorderColor DarkBlue
skinparam nodesep 90
skinparam ranksep 120
skinparam linetype ortho

rectangle "Command Entry" {
	component [Main CLI\n(main.c)] as main <<executable>>
}

rectangle "Command Layer" {
	component [Command Context\n(command_context.c)] as cmd_ctx
	component [Command Registry\n(command_registry.c)] as cmd_reg

	rectangle "Command Pool" {
		component [cmd_install\ncmd_build\ncmd_resolve] as cmd_pkg
		component [cmd_remove\ncmd_autoremove] as cmd_rm
		component [cmd_download\ncmd_repo\ncmd_repos\ncmd_repo_update\ncmd_clean_cache] as cmd_misc
	}
}

' Core components (ordered by workflow)
rectangle "Core Workflow" {
	component [Config\n(config.c)] as config
	component [Parser\n(parser.c)] as parser
	component [Solver\n(solver.c)] as solver
	component [Downloader\n(downloader.c)] as downloader
	component [Builder\n(builder.c)] as builder
	component [Installer\n(installer.c)] as installer
}

rectangle "Shared Services" {
	component [Common\n(common.c)] as common
}

rectangle "Utilities" {
	component [CLI Helpers\n(cli_helpers.c)] as cli_helpers
	component [System Helpers\n(system_helpers.c)] as sys_helpers
	component [Print\n(print.c)] as print_util
	component [String Helpers\n(string_helpers.c)] as str_helpers
}

' Provided interfaces (lollipop)
interface "ICommandContext" as ICmdCtx
interface "ICommandDispatcher" as ICmdDisp
interface "IConfigManager" as IConfigMgr
interface "IRepositoryLoader" as IRepoLoader
interface "IDependencyResolver" as IDepResolver
interface "IPackageDownloader" as IPkgDownloader
interface "IPackageBuilder" as IPkgBuilder
interface "IPackageInstaller" as IPkgInstaller
interface "ILogger" as ILogger
interface "ICLIHelper" as ICLIHelper
interface "IPrinter" as IPrinter
interface "ISystemHelper" as ISysHelper
interface "IStringHelper" as IStrHelper

cmd_ctx -up- ICmdCtx
cmd_reg -up- ICmdDisp
config -up- IConfigMgr
parser -up- IRepoLoader
solver -up- IDepResolver
downloader -up- IPkgDownloader
builder -up- IPkgBuilder
installer -up- IPkgInstaller
common -up- ILogger
cli_helpers -up- ICLIHelper
print_util -up- IPrinter
sys_helpers -up- ISysHelper
str_helpers -up- IStrHelper

' Required interfaces – assembly connectors
main --( ICmdCtx
main --( ICmdDisp

cmd_reg --( ICmdCtx

cmd_pkg --( IRepoLoader
cmd_pkg --( IDepResolver
cmd_pkg --( IPkgDownloader
cmd_pkg --( IPkgBuilder
cmd_pkg --( IPkgInstaller

cmd_rm --( IPkgInstaller

cmd_misc --( IRepoLoader
cmd_misc --( IPkgDownloader
cmd_misc --( IConfigMgr

' Logger dependencies
parser --( ILogger
solver --( ILogger
downloader --( ILogger
builder --( ILogger
installer --( ILogger
config --( ILogger

' ==================== UTILS USAGE ====================

' system_helpers: parser vola set_system_arch(pool)
parser --( ISysHelper

' string_helpers: print.c vola solvable_to_string()
print_util --( IStrHelper

' cli_helpers (user_confirm / print_usage):
' command_context: print_usage() pri --help
cmd_ctx --( ICLIHelper
' solver: user_confirm() pri dependency problems
solver --( ICLIHelper
' installer: user_confirm() pri install/remove
installer --( ICLIHelper
' builder: user_confirm() pri selhani buildu
builder --( ICLIHelper
' cmd_pkg (install/download): user_confirm() + display_transaction()
cmd_pkg --( ICLIHelper
cmd_pkg --( IPrinter
' cmd_misc (clean_cache): user_confirm()
cmd_misc --( ICLIHelper

' ==================== INTERFACE NOTES ====================

note right of ICmdCtx
  **ICommandContext API:**
  • command_context_create()
  • command_context_init_subsystems()
  • command_context_parse_args()
  • command_context_destroy()
  
  Holds CLI config flags + lazy
  subsystem function pointers.
  Enables mock injection in tests.
end note

note right of ICmdDisp
  **ICommandDispatcher API:**
  • command_dispatch()
  • command_find()
  • command_list_all()
  
  Static table, zero heap.
  Calls validate() before execute().
end note

note right of IConfigMgr
  **IConfigManager API:**
  • init_repo_config()
  • get_primary_repo_url()
  • get_enabled_repos()
  • add_repository()
  • remove_repository()
  • enable_repository()
  • save_repo_config()
  • list_repositories()
  • free_repo_config()
end note

note right of IRepoLoader
  **IRepositoryLoader API:**
  • load_repository()
  • load_json()
  • get_custom_source()
  • get_custom_source_array()
  • get_custom_mkdeps()
  • get_custom_extras()
  • get_custom_is_group()
  • get_custom_no_package()
  • parse_depends_to_solvable()
  • generate_repodata()
  • update_repository_metadata()
  • add_package_tar_bz2()
  • internalize_repo()
end note

note right of IDepResolver
  **IDependencyResolver API:**
  • create_solver()
  • solve_dependencies()
  • add_mkdeps_to_queue()
  • display_problem_proof()
end note

note right of IPkgDownloader
  **IPackageDownloader API:**
  • download_package()
  • extract_and_check_embedded_source()
  • download_extras()
  • download_package_to_directory()
  • download_url_to_file()
  • get_cache_dir()
end note

note right of IPkgBuilder
  **IPackageBuilder API:**
  • commit_element()
  • extract_archive()
  • find_source_path()
  • find_build_or_source()
  • apply_extras()
  • set_staging_enabled()
  • set_staging_dir()
  • set_build_tmp_dir()
  • run_with_chroot()
end note

note right of IPkgInstaller
  **IPackageInstaller API:**
  • install_package()
  • install_package_with_reason()
  • is_package_installed()
  • get_installed_packages()
  • load_installed_db()
  • erase_package()
  • validate_chroot()
  • find_reverse_dependencies(cb)
  • find_orphaned_packages(cb)
  • autoremove_packages(cb)
  • erase_package_with_checks(cb)
end note

note left of ILogger
  **ILogger API:**
  • log_error()
  • log_warn()
  • log_info()
  • log_debug()
end note

note right of ICLIHelper
  **ICLIHelper API:**
  • user_confirm(prompt, default)
  • print_usage(exit_code)
  
  Callers: command_context, solver,
  installer, builder, cmd_install,
  cmd_download, cmd_clean_cache
end note

note right of IPrinter
  **IPrinter API:**
  • display_transaction(trans)
  • print_disk_usage_changes(trans)
  
  Callers: cmd_install, cmd_resolve,
  cmd_download
end note

note right of ISysHelper
  **ISystemHelper API:**
  • set_system_arch(Pool*)
  • get_pool_arch(Pool*)
  
  Uses libsolv Pool* directly.
  Caller: parser (load_repository)
end note

note right of IStrHelper
  **IStringHelper API:**
  • solvable_to_string(Pool*, Id)
  
  Uses libsolv Pool* directly.
  Caller: print.c
end note

@enduml
