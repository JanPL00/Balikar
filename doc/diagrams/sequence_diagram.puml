@startuml Balikar Build Sequence Diagram

title Balikar Package Manager - Build Workflow Sequence

actor User
participant "Main CLI" as Main
participant "Config" as Config
participant "Parser" as Parser
participant "Solver" as Solver
participant "Downloader" as Downloader
participant "Builder" as Builder
database "Repository" as Repo
database "Cache" as Cache
database "Staging" as Staging

User -> Main: balikar build <package>

== INITIALIZATION ==
Main -> Config: init_repo_config()
Config -> Config: Load repos.conf\n(user > system > default)
Config --> Main: repo_config_t

Main -> Config: get_primary_repo_url()
Config --> Main: repo_url

== PARSE PHASE ==
Main -> Parser: load_repository(pool, repo_url)
Parser -> Repo: Check repodata.json exists?
alt repodata.json missing or outdated
    Parser -> Repo: Scan index.json files
    Parser -> Parser: generate_repodata()
    Parser -> Repo: Write repodata.json
end

Parser -> Repo: Read repodata.json
Parser -> Parser: repo_add_conda()
Parser -> Parser: add_custom_fields_to_repodata()
Parser -> Parser: set_system_arch()
Parser --> Main: Repo*

== SOLVE PHASE ==
Main -> Solver: create_solver(pool)
Solver -> Solver: Configure solver flags
Solver --> Main: Solver*

Main -> Solver: solve_dependencies(solver, package, pool, repo)
Solver -> Parser: Find Solvable for package
Parser --> Solver: Solvable Id

loop For each package in dependency tree
    Solver -> Parser: get_custom_mkdeps(data, p, pool)
    Parser --> Solver: makedeps[]
    
    loop For each makedep (recursive)
        Solver -> Solver: add_mkdeps_to_queue(job, mkdep_id, depth)
        note right: Recursion depth limit = 10
    end
end

Solver -> Solver: Add main package to job
Solver -> Solver: solver_solve(solver, job)

alt Solver problems found
    Solver -> Solver: display_problem_proof()
    Solver -> User: Show conflict details
    User -> Solver: Continue? [y/n/q]
    alt User cancels
        Solver --> Main: NULL (abort)
        Main --> User: Aborted
    end
end

Solver -> Solver: solver_create_transaction()
Solver -> Solver: transaction_order()
Solver -> Solver: transaction_installedresult()
Solver -> User: Display transaction\n(packages to build)
Solver --> Main: Queue* (ordered packages)

== USER CONFIRMATION ==
Main -> User: Proceed with build? [y/n/q]
User --> Main: y

== DOWNLOAD PHASE ==
loop For each package in transaction
    Main -> Parser: get_custom_source_array(data, p, pool)
    Parser --> Main: source[] URLs
    
    Main -> Downloader: download_package(solvable, url, pool, data)
    Downloader -> Cache: Check if cached
    
    alt Cache miss
        loop Try each URL in source[] array
            Downloader -> Downloader: Try source[i].url
            alt Remote URL
                Downloader -> Downloader: curl download with progress bar
                note right: [=====>     ] 45%
            else Local path
                Downloader -> Downloader: cp to cache
            end
            
            alt Download success
                Downloader -> Cache: Save package
                note right: Break loop
            else Download failed
                Downloader -> Downloader: Try next URL
            end
        end
        
        alt All URLs failed
            Downloader -> Downloader: Try local repository fallback
        end
    end
    
    Downloader --> Main: FILE* (package archive)
    
    Main -> Parser: get_custom_extras(data, p, pool)
    Parser --> Main: extras[]
    
    opt Has extras (patches)
        Main -> Downloader: download_extras(extras, pkg_name)
        loop For each extra URL
            Downloader -> Cache: Download patch to extras/<pkg>/
        end
    end
end

== BUILD PHASE ==
loop For each package in transaction
    Main -> Builder: commit_element(trans, data, p, fp, pool)
    
    Builder -> Builder: Check metadata flags
    alt no_package == true
        Builder --> Main: Skip (virtual package)
        note right: Virtual dependency, no actual build
    end
    
    Builder -> Builder: mkdtemp(build_tmp_dir)
    note right: /tmp/balikar_build_<pkg>_XXXXXX
    
    Builder -> Builder: detect_compression(fp)
    Builder -> Builder: extract_archive(fp, build_dir)
    note right: Supports tar.gz, tar.xz, tar.bz2
    
    Builder -> Builder: find_source_path(build_dir)
    note right: Recursive search for .build\n(depth=3)
    
    opt Has extras
        Builder -> Builder: apply_extras(extras, pkg_name, source_dir)
        loop For each patch
            Builder -> Builder: patch -p1 < patch_file
        end
    end
    
    Builder -> Builder: Set environment:\nDESTDIR=$P\nMAKEFLAGS=-j$(nproc)
    
    alt is_group == true
        Builder --> Main: Skip build (meta-package)
        note right: Only extract, no build
    else Normal package
        Builder -> Builder: chdir(source_dir)
        
        alt .build script exists
            Builder -> Builder: bash -e .build
        else Fallback
            Builder -> Builder: ./configure --prefix=/usr\nmake\nmake install
        end
        
        alt Build failed
            Builder -> User: Build failed (exit code)\nRetry? [y/n]
            alt User chooses retry
                Builder -> Builder: Re-run build
            else User aborts
                Builder --> Main: -1 (build error)
            end
        end
    end
    
    Builder -> Staging: Install to $P/
    note right: DESTDIR staging area
    
    Builder -> Builder: Cleanup build_dir
    Builder -> Builder: rm -rf /tmp/balikar_build_*
    
    Builder --> Main: 0 (success)
end

== COMPLETION ==
Main -> User: Build completed successfully
Main -> User: Packages staged in: $P/
note right: Ready for installation phase (TODO)

@enduml
