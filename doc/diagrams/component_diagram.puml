@startuml Balikar Component Diagram

title Balikar Package Manager - Component Diagram (UML 2.5 Standard)

skinparam componentStyle rectangle
skinparam component {
    BackgroundColor<<executable>> LightBlue
    BackgroundColor<<component>> LightYellow
    BackgroundColor<<library>> LightGreen
    BackgroundColor<<datastore>> LightGray
    BackgroundColor<<dispatcher>> LightSalmon
    BackgroundColor<<facade>> #FFE4B5
    BackgroundColor<<command>> #E6FFE6
    BorderColor Black
    ArrowColor DarkBlue
}

skinparam interface {
    BackgroundColor LightCyan
    BorderColor DarkBlue
}

left to right direction

' ==================== HLAVNÍ EXECUTABLE ====================
component [Main CLI\n(main.c)] as main <<executable>>

' ==================== COMMAND LAYER ====================
package "Command Layer" {
    component [Command Context\n(command_context.c)\nShared state +\nsubsystem facade] as cmd_ctx <<facade>>
    component [Command Registry\n(command_registry.c)\nStatic command table\n+ dispatcher] as cmd_reg <<dispatcher>>

    package "Command Pool" {
        component [cmd_install] as cmd_install <<command>>
        component [cmd_build] as cmd_build <<command>>
        component [cmd_resolve] as cmd_resolve <<command>>
        component [cmd_remove] as cmd_remove <<command>>
        component [cmd_autoremove] as cmd_autoremove <<command>>
        component [cmd_download] as cmd_download <<command>>
        component [cmd_repo] as cmd_repo <<command>>
        component [cmd_repo_update] as cmd_repo_update <<command>>
        component [cmd_repos] as cmd_repos <<command>>
        component [cmd_clean_cache] as cmd_clean <<command>>
    }
}

' ==================== CORE MODULY ====================
package "Core Modules" {
    component [Parser\n(parser.c)] as parser <<component>>
    component [Solver\n(solver.c)] as solver <<component>>
    component [Downloader\n(downloader.c)] as downloader <<component>>
    component [Builder\n(builder.c)] as builder <<component>>
    component [Installer\n(installer.c)] as installer <<component>>
    component [Config\n(config.c)] as config <<component>>
    component [Common\n(common.c)] as common <<component>>
}

' ==================== UTILITY MODULY ====================
package "Utilities" {
    component [CLI Helpers] as cli_helpers <<component>>
    component [System Helpers] as sys_helpers <<component>>
    component [Print] as print <<component>>
    component [Debug] as debug <<component>>
}

' ==================== EXTERNÍ KNIHOVNY ====================
package "External Libraries" {
    component [libsolv] as libsolv <<library>>
    component [jansson] as jansson <<library>>
    component [libcurl] as libcurl <<library>>
    ' libarchive: linked but NOT used at C API level
    ' builder.c uses popen("tar ...") instead
}

' ==================== DATOVÁ ÚLOŽIŠTĚ ====================
package "Data Storage" {
    database "Repository" as repo <<datastore>>
    database "Cache" as cache <<datastore>>
    database "Staging" as staging <<datastore>>
    database "Installed DB" as instdb <<datastore>>
}

' ==================== KNIHOVNÍ ZÁVISLOSTI ====================

' libsolv: parser (vytváří Pool/Repo/Solvable), solver (Solver/Transaction)
'          + utils: sys_helpers, print, string_helpers přijímají Pool* přímo
parser ..> libsolv
solver ..> libsolv
sys_helpers ..> libsolv
print ..> libsolv

' libcurl: downloader (balíčky) + parser (stahuje repodata.json přes HTTP)
downloader ..> libcurl
parser ..> libcurl

' jansson: parser (repodata.json), installer (installed.json), builder (index.json)
parser ..> jansson
installer ..> jansson
builder ..> jansson

' ==================== DATA FLOW ====================

parser --> repo
downloader --> cache
builder --> staging
installer --> staging
installer --> instdb

' ==================== PROVIDED INTERFACES (Lollipop notation) ====================

' Command Layer interfaces
interface "ICommandContext" as ICmdCtx
interface "ICommandDispatcher" as ICmdDisp

' Core module interfaces
interface "IRepositoryLoader" as IRepoLoader
interface "IDependencyResolver" as IDepResolver
interface "IPackageDownloader" as IPkgDownloader
interface "IPackageBuilder" as IPkgBuilder
interface "IPackageInstaller" as IPkgInstaller
interface "IConfigManager" as IConfigMgr
interface "ILogger" as ILogger
interface "ICLIHelper" as ICLIHelper
interface "IPrinter" as IPrinter
interface "IDebugger" as IDebugger
interface "ISystemHelper" as ISysHelper

' Command layer provides interfaces
cmd_ctx -up- ICmdCtx
cmd_reg -up- ICmdDisp

' Core modules provide interfaces (lollipop notation)
parser -up- IRepoLoader
solver -up- IDepResolver
downloader -up- IPkgDownloader
builder -up- IPkgBuilder
installer -up- IPkgInstaller
config -up- IConfigMgr
common -up- ILogger
cli_helpers -up- ICLIHelper
print -up- IPrinter
debug -up- IDebugger
sys_helpers -up- ISysHelper

' ==================== REQUIRED INTERFACES (Assembly connectors) ====================

' Main requires only command layer interfaces (no direct core access)
main --( ICmdCtx
main --( ICmdDisp

' Command Registry requires Command Context (to pass ctx to commands)
cmd_reg --( ICmdCtx

' Command Pool requires core module interfaces (via ctx->subsystems facade)
' NOTE: Commands access core APIs *only* through CommandContext subsystem pointers,
' not through direct function calls. This enables mock injection for testing.
cmd_install --( IRepoLoader
cmd_install --( IDepResolver
cmd_install --( IPkgDownloader
cmd_install --( IPkgBuilder
cmd_install --( IPkgInstaller

cmd_build --( IRepoLoader
cmd_build --( IDepResolver
cmd_build --( IPkgDownloader
cmd_build --( IPkgBuilder
cmd_build --( IPkgInstaller

cmd_resolve --( IRepoLoader
cmd_resolve --( IDepResolver

cmd_remove --( IPkgInstaller
cmd_autoremove --( IPkgInstaller

cmd_download --( IRepoLoader
cmd_download --( IDepResolver
cmd_download --( IPkgDownloader

cmd_repo --( IConfigMgr
cmd_repo_update --( IConfigMgr
cmd_repo_update --( IRepoLoader
cmd_repos --( IConfigMgr

' Logger dependencies (all modules use common)
parser --( ILogger
solver --( ILogger
downloader --( ILogger
builder --( ILogger
installer --( ILogger
config --( ILogger

' ==================== UTILS ZÁVISLOSTI ====================

' system_helpers: parser volá set_system_arch()
parser --( ISysHelper

' string_helpers: print.c volá solvable_to_string()
print --( ISysHelper

' cli_helpers (user_confirm, print_usage):
' command_context volá print_usage()
cmd_ctx --( ICLIHelper
' solver volá user_confirm() při problémech
solver --( ICLIHelper
' installer volá user_confirm() při instalaci/odebrání
installer --( ICLIHelper
' builder volá user_confirm() při selhání buildu
builder --( ICLIHelper
' přímo z command poolu:
cmd_install --( ICLIHelper
cmd_download --( ICLIHelper
cmd_clean --( ICLIHelper

' print (display_transaction):
cmd_install --( IPrinter
cmd_resolve --( IPrinter
cmd_download --( IPrinter

' ==================== INTERFACE NOTES ====================

note right of ICmdCtx
    **ICommandContext API:**
    + command_context_create()
    + command_context_init_subsystems()
    + command_context_parse_args()
    + command_context_destroy()
    
    **Subsystem Facade (ctx->subsystems):**
    • load_repository / generate_repodata
    • create_solver / solve_dependencies
    • download_package / download_extras
    • commit_element
    • install_package_with_reason
    • erase_package / is_package_installed
end note

note right of ICmdDisp
    **ICommandDispatcher API:**
    + command_dispatch()
    + command_find()
    + command_list_all()
    
    **Registered Commands:**
    install, build, resolve, remove,
    autoremove, download, repo,
    repo-update, repos, clean-cache
end note

note right of IRepoLoader
    **IRepositoryLoader API:**
    + load_repository()
    + load_json()
    + get_custom_source()
    + get_custom_source_array()
    + get_custom_mkdeps()
    + get_custom_extras()
    + get_custom_is_group()
    + get_custom_no_package()
    + parse_depends_to_solvable()
    + generate_repodata()
    + update_repository_metadata()
    + add_package_tar_bz2()
    + internalize_repo()
end note

note right of IDepResolver
    **IDependencyResolver API:**
    + create_solver()
    + solve_dependencies()
    + add_mkdeps_to_queue()
    + display_problem_proof()
end note

note right of IPkgDownloader
    **IPackageDownloader API:**
    + download_package()
    + extract_and_check_embedded_source()
    + download_extras()
    + download_package_to_directory()
    + download_url_to_file()
    + get_cache_dir()
end note

note right of IPkgBuilder
    **IPackageBuilder API:**
    + commit_element()
    + extract_archive()
    + find_source_path()
    + find_build_or_source()
    + apply_extras()
    + set_staging_enabled()
    + set_staging_dir()
    + set_build_tmp_dir()
    + run_with_chroot()
end note

note right of IPkgInstaller
    **IPackageInstaller API:**
    + install_package()
    + install_package_with_reason()
    + is_package_installed()
    + get_installed_packages()
    + load_installed_db()
    + erase_package()
    + validate_chroot()
    + find_reverse_dependencies(cb)
    + find_orphaned_packages(cb)
    + autoremove_packages(cb)
    + erase_package_with_checks(cb)
end note

note right of IConfigMgr
    **IConfigManager API:**
    + init_repo_config()
    + get_primary_repo_url()
    + get_enabled_repos()
    + add_repository()
    + remove_repository()
    + enable_repository()
    + save_repo_config()
    + list_repositories()
    + free_repo_config()
end note

note left of ILogger
    **ILogger API:**
    + log_error()
    + log_warn()
    + log_info()
    + log_debug()
end note

note left of ICLIHelper
    **ICLIHelper API:**
    + print_usage()
    + user_confirm()
end note

note left of IPrinter
    **IPrinter API:**
    + display_transaction()
    + print_disk_usage_changes()
end note

note left of ISysHelper
    **ISystemHelper API:**
    + set_system_arch()
    + get_pool_arch()
end note

' ==================== WORKFLOW NOTES ====================

note top of main
    **Entry Point (Command Pattern)**
    1. command_context_create()
    2. command_context_init_subsystems()
    3. command_context_parse_args()
    4. command_dispatch()
    5. command_context_destroy()
    
    No direct dependency on core modules.
end note

note top of cmd_ctx
    **Shared State + Subsystem Facade**
    Holds CLI config (flags, package name,
    chroot path, repo filter, etc.) and
    injects subsystem function pointers.
    Enables mock substitution for testing.
end note

note top of cmd_reg
    **Static Command Table (zero heap)**
    Commands registered at compile time.
    Dispatches by string lookup.
    Calls validate() before execute().
end note

note bottom of builder
    **Build Phases:**
    1. Extract archive to /tmp
    2. Find source directory (BFS)
    3. Apply extras (.build, patches)
    4. Set environment ($P, DESTDIR)
    5. Execute .build script
    6. Stage to $P/DESTDIR
    7. Cleanup temp directory
end note

note bottom of solver
    **Dependency Resolution:**
    1. Create job queue
    2. Add makedeps recursively
    3. Add runtime depends
    4. Solve with libsolv
    5. Create transaction
    6. Order by dependencies
end note

note bottom of downloader
    **Multi-source Fallback:**
    Tries all URLs in source[]
    array until success.
    Caches downloads in
    /var/cache/balikar/
end note

note bottom of installer
    **Installation Phases:**
    1. Validate chroot structure
    2. Collect file manifest
    3. Merge staging to chroot (cp -a)
    4. Execute .install/install.sh
    5. Update installed.json database
    
    **Database Location:**
    /var/lib/balikar/installed.json
end note

note right of config
    **Configuration Files:**
    - ~/.config/balikar/repos.conf (user)
    - /etc/balikar/repos.conf (system)
    - ./repos.conf (fallback)
    
    **Repository Priority:**
    Higher priority = preferred
    Disabled repos are skipped
end note

@enduml
