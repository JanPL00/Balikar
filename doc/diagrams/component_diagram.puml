@startuml Balikar Component Diagram

title Balikar Package Manager - Component Diagram (UML 2.5 Standard)

skinparam componentStyle rectangle
skinparam component {
    BackgroundColor<<executable>> LightBlue
    BackgroundColor<<component>> LightYellow
    BackgroundColor<<library>> LightGreen
    BackgroundColor<<datastore>> LightGray
    BorderColor Black
    ArrowColor DarkBlue
}

skinparam interface {
    BackgroundColor LightCyan
    BorderColor DarkBlue
}

' ==================== HLAVNÍ EXECUTABLE ====================
package "Balikar Executable" {
    component [Main CLI\n(main.c)] as main <<executable>>
}

' ==================== CORE MODULY ====================
package "Core Modules" {
    component [Parser Module\n(parser.c)] as parser <<component>>
    component [Solver Module\n(solver.c)] as solver <<component>>
    component [Downloader Module\n(downloader.c)] as downloader <<component>>
    component [Builder Module\n(builder.c)] as builder <<component>>
    component [Installer Module\n(installer.c)] as installer <<component>>
    component [Config Module\n(config.c)] as config <<component>>
    component [Common Module\n(common.c)] as common <<component>>
}

' ==================== UTILITY MODULY ====================
package "Utility Modules" {
    component [CLI Helpers\n(cli_helpers.c)] as cli_helpers <<component>>
    component [System Helpers\n(system_helpers.c)] as sys_helpers <<component>>
    component [Print Module\n(print.c)] as print <<component>>
    component [Debug Module\n(debug.c)] as debug <<component>>
}

' ==================== EXTERNÍ KNIHOVNY ====================
package "External Libraries" {
    component [libsolv] as libsolv <<library>> {
        note right
            Pool, Repo, Solvable
            Solver, Transaction
        end note
    }
    
    component [jansson] as jansson <<library>> {
        note right
            JSON parsing
            json_t structures
        end note
    }
    
    component [libcurl] as libcurl <<library>> {
        note right
            HTTP/HTTPS
            download
        end note
    }
    
    component [libarchive/tar] as libarchive <<library>> {
        note right
            Archive extraction
            tar.xz, tar.bz2
        end note
    }
}

' ==================== DATOVÁ ÚLOŽIŠTĚ ====================
package "Data Storage" {
    database "Repository\n./repo/" as repo <<datastore>> {
        note right
            repodata.json
            index.json files
            package structure
        end note
    }
    
    database "Download Cache\n/var/cache/balikar/" as cache <<datastore>> {
        note right
            Downloaded packages
            extras (patches)
        end note
    }
    
    database "Staging Area\n$P/ or custom" as staging <<datastore>> {
        note right
            Built packages
            DESTDIR output
        end note
    }
    
    database "Build Temp\n/tmp/balikar_build_*" as buildtemp <<datastore>>
}

' Note: Dependencies are now modeled through interface connections above
' using UML lollipop (provided) and socket (required) notation

' ==================== KNIHOVNÍ ZÁVISLOSTI ====================

parser ..> libsolv : Pool/Repo API
parser ..> jansson : JSON parsing
solver ..> libsolv : Solver API
downloader ..> libcurl : HTTP download
builder ..> libarchive : extraction

' ==================== DATA FLOW ====================

parser --> repo : reads
downloader --> cache : reads/writes
builder --> buildtemp : writes (temp)
builder --> staging : writes (build output)
installer --> staging : reads
installer ..> cache : writes (installed.json)

' ==================== PROVIDED INTERFACES (Lollipop notation) ====================

' Provided interfaces (lollipop - circle symbol)
interface "IRepositoryLoader" as IRepoLoader
interface "IDependencyResolver" as IDepResolver
interface "IPackageDownloader" as IPkgDownloader
interface "IPackageBuilder" as IPkgBuilder
interface "IPackageInstaller" as IPkgInstaller
interface "IConfigManager" as IConfigMgr
interface "ILogger" as ILogger
interface "ICLIHelper" as ICLIHelper
interface "IPrinter" as IPrinter
interface "IDebugger" as IDebugger
interface "ISystemHelper" as ISysHelper

' Components provide interfaces (lollipop notation)
parser -up- IRepoLoader
solver -up- IDepResolver
downloader -up- IPkgDownloader
builder -up- IPkgBuilder
installer -up- IPkgInstaller
config -up- IConfigMgr
common -up- ILogger
cli_helpers -up- ICLIHelper
print -up- IPrinter
debug -up- IDebugger
sys_helpers -up- ISysHelper

' ==================== REQUIRED INTERFACES (Assembly connectors) ====================

' Main requires interfaces from all modules
main --( IRepoLoader
main --( IDepResolver
main --( IPkgDownloader
main --( IPkgBuilder
main --( IPkgInstaller
main --( IConfigMgr
main --( ICLIHelper

' Builder requires interfaces from other modules
builder --( IRepoLoader : metadata
builder --( IPkgDownloader : files
builder --( IDepResolver : transaction

' Installer requires builder and parser
installer --( IPkgBuilder : after build
installer --( IRepoLoader : metadata

' Downloader requires parser for URLs
downloader --( IRepoLoader : source URLs

' Solver requires parser for dependencies
solver --( IRepoLoader : dependencies

' Parser requires config for repo URL
parser --( IConfigMgr : repo URL

' All core modules require common logger
parser --( ILogger
solver --( ILogger
downloader --( ILogger
builder --( ILogger
installer --( ILogger
config --( ILogger

' Utilities required by various modules
parser --( ISysHelper : arch detection
builder --( IPrinter : output
solver --( IPrinter : transaction
main --( IPrinter : disk usage
solver --( IDebugger : problem proof

