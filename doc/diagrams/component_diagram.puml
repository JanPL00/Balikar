@startuml Balikar Component Diagram

title Balikar Package Manager - Component Diagram

skinparam componentStyle rectangle
skinparam component {
    BackgroundColor<<executable>> LightBlue
    BackgroundColor<<component>> LightYellow
    BackgroundColor<<library>> LightGreen
    BackgroundColor<<datastore>> LightGray
    BorderColor Black
    ArrowColor DarkBlue
}

' ==================== HLAVNÍ EXECUTABLE ====================
package "Balikar Executable" {
    component [Main CLI\n(main.c)] as main <<executable>>
}

' ==================== CORE MODULY ====================
package "Core Modules" {
    component [Parser Module\n(parser.c)] as parser <<component>>
    component [Solver Module\n(solver.c)] as solver <<component>>
    component [Downloader Module\n(downloader.c)] as downloader <<component>>
    component [Builder Module\n(builder.c)] as builder <<component>>
    component [Config Module\n(config.c)] as config <<component>>
    component [Common Module\n(common.c)] as common <<component>>
}

' ==================== UTILITY MODULY ====================
package "Utility Modules" {
    component [CLI Helpers\n(cli_helpers.c)] as cli_helpers <<component>>
    component [System Helpers\n(system_helpers.c)] as sys_helpers <<component>>
    component [Print Module\n(print.c)] as print <<component>>
    component [Debug Module\n(debug.c)] as debug <<component>>
}

' ==================== EXTERNÍ KNIHOVNY ====================
package "External Libraries" {
    component [libsolv] as libsolv <<library>> {
        note right
            Pool, Repo, Solvable
            Solver, Transaction
        end note
    }
    
    component [jansson] as jansson <<library>> {
        note right
            JSON parsing
            json_t structures
        end note
    }
    
    component [libcurl] as libcurl <<library>> {
        note right
            HTTP/HTTPS
            download
        end note
    }
    
    component [libarchive/tar] as libarchive <<library>> {
        note right
            Archive extraction
            tar.xz, tar.bz2
        end note
    }
}

' ==================== DATOVÁ ÚLOŽIŠTĚ ====================
package "Data Storage" {
    database "Repository\n./repo/" as repo <<datastore>> {
        note right
            repodata.json
            index.json files
            package structure
        end note
    }
    
    database "Download Cache\n/var/cache/balikar/" as cache <<datastore>> {
        note right
            Downloaded packages
            extras (patches)
        end note
    }
    
    database "Staging Area\n$P/ or custom" as staging <<datastore>> {
        note right
            Built packages
            DESTDIR output
        end note
    }
    
    database "Build Temp\n/tmp/balikar_build_*" as buildtemp <<datastore>>
}

' ==================== HLAVNÍ DEPENDENCY VZTAHY ====================

' Main používá všechny moduly
main ..> parser : uses
main ..> solver : uses
main ..> downloader : uses
main ..> builder : uses
main ..> config : uses
main ..> cli_helpers : uses

' Dependency chain mezi moduly
builder ..> downloader : needs files
builder ..> parser : needs metadata
builder ..> solver : needs transaction
downloader ..> parser : needs source URLs
solver ..> parser : needs dependencies
parser ..> config : needs repo URL

' Všechny moduly používají Common
parser ..> common : logging
solver ..> common : logging
downloader ..> common : logging
builder ..> common : logging
config ..> common : logging

' Utility dependencies
main ..> cli_helpers : user interaction
parser ..> sys_helpers : arch detection
builder ..> print : formatted output
solver ..> print : transaction display

' ==================== KNIHOVNÍ ZÁVISLOSTI ====================

parser ..> libsolv : Pool/Repo API
parser ..> jansson : JSON parsing
solver ..> libsolv : Solver API
downloader ..> libcurl : HTTP download
builder ..> libarchive : extraction

' ==================== DATA FLOW ====================

parser --> repo : reads
downloader --> cache : reads/writes
builder --> buildtemp : writes (temp)
builder --> staging : writes (final)

' ==================== PROVIDED INTERFACES ====================

interface "IRepositoryLoader" as IRepoLoader
interface "IDependencyResolver" as IDepResolver
interface "IPackageDownloader" as IPkgDownloader
interface "IPackageBuilder" as IPkgBuilder

parser - IRepoLoader
solver - IDepResolver
downloader - IPkgDownloader
builder - IPkgBuilder

note right of IRepoLoader
    load_repository()
    get_custom_source()
    get_custom_mkdeps()
    parse_depends()
end note

note right of IDepResolver
    solve_dependencies()
    create_solver()
    add_mkdeps_to_queue()
end note

note right of IPkgDownloader
    download_package()
    download_extras()
    multi-source fallback
end note

note right of IPkgBuilder
    commit_element()
    extract_archive()
    apply_extras()
    find_source_path()
end note

' ==================== WORKFLOW NOTES ====================

note top of main
    **Entry Point**
    Commands: build, install, resolve,
    repos, download, clean-cache
end note

note bottom of builder
    **Build Phases:**
    1. Extract archive
    2. Find .build script
    3. Apply patches
    4. Execute build
    5. Stage to $P
end note

note bottom of solver
    **Dependency Resolution:**
    1. Recursive makedeps
    2. Runtime depends
    3. Transaction ordering
    4. Conflict detection
end note

note bottom of downloader
    **Multi-source Fallback:**
    Tries all URLs in source[]
    array until success
end note

@enduml
