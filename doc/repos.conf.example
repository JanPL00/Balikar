# Příklad konfigurace repozitářů pro Balikar
# Zkopírujte do ~/.config/balikar/repos.conf nebo /etc/balikar/repos.conf

# Oficiální Balikar repozitář na GitHubu
# Nejvyšší priorita - používá se jako primární zdroj metadat
[balikar-official]
url = https://raw.githubusercontent.com/JanPL00/balikar-repository/main
priority = 100
enabled = true

# Lokální vývojový repozitář
# Nižší priorita - používá se při vývoji nových balíčků
[local-dev]
url = ./repo
priority = 50
enabled = true

# Příklad: LFS oficiální balíčky (zakázané)
[lfs-upstream]
url = https://www.linuxfromscratch.org/lfs/packages
priority = 30
enabled = false

# Příklad: Mirror (záložní repozitář)
[balikar-mirror]
url = https://mirror.example.com/balikar-repo/main
priority = 90
enabled = false
